<Window x:Class="PAAOM_Server.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:properties ="clr-namespace:PAAOM_Server.Properties"
        xmlns:local="clr-namespace:PAAOM_Server"
        Title="{x:Static properties:Resources.Window_SystemParametrs}"
        Width="549" Height="480"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="Label">
            <Setter Property="Margin" Value="0,10,0,0"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="7*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>
        <TabControl Grid.ColumnSpan="2">
            <!-- Вкладка параметров среды -->
            <TabItem Header="{x:Static properties:Resources.Environment}">
                <StackPanel>
                    <GroupBox Header="{x:Static properties:Resources.Environment_AirParametrs}">
                        <StackPanel>
                            <Label Content = "{x:Static properties:Resources.Environment_AirTemperature}"/>
                            <TextBox Text="{Binding EnvironmentSettings.Temperature, UpdateSourceTrigger=PropertyChanged}"/>

                            <Label Content="{x:Static properties:Resources.Environment_NoiseLevel}"/>
                            <TextBox Text="{Binding EnvironmentSettings.NoiseLevel, UpdateSourceTrigger=LostFocus}"
                                PreviewTextInput="NoiseLevelTextBox_PreviewTextInput"
                                TextChanged="NoiseLevelTextBox_TextChanged"/>

                            <Label Content="{x:Static properties:Resources.Environment_SoundSpeed}"/>
                            <TextBlock Text="{Binding EnvironmentSettings.SoundSpeed, StringFormat={}{0:F2}}"
                                Margin="0,5" FontStyle="Italic"/>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </TabItem>

            <!-- Вкладка источника звука -->
            <TabItem Header="{x:Static properties:Resources.Source}">
                <StackPanel>
                    <GroupBox Header="{x:Static properties:Resources.Source_Pos}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>

                            <Label Content="{x:Static properties:Resources.Source_PosX}" Grid.Row="0" Grid.Column="0"/>
                            <TextBox Text="{Binding AudioSource.X, UpdateSourceTrigger=PropertyChanged}" 
                                    Grid.Row="0" Grid.Column="1"/>

                            <Label Content="{x:Static properties:Resources.Source_PosY}" Grid.Row="1" Grid.Column="0"/>
                            <TextBox Text="{Binding AudioSource.Y, UpdateSourceTrigger=PropertyChanged}" 
                                    Grid.Row="1" Grid.Column="1"/>

                            <Label Content="{x:Static properties:Resources.Source_PosZ}" Grid.Row="2" Grid.Column="0"/>
                            <TextBox Text="{Binding AudioSource.Z, UpdateSourceTrigger=PropertyChanged}" 
                                    Grid.Row="2" Grid.Column="1"/>
                        </Grid>
                    </GroupBox>

                    <GroupBox Header="{x:Static properties:Resources.Source_SignalParametrs}">
                        <StackPanel>
                            <Label Content="{x:Static properties:Resources.Source_SignalFrequency}"/>
                            <TextBox Text="{Binding AudioSource.Frequency, UpdateSourceTrigger=PropertyChanged}"/>

                            <Label Content="{x:Static properties:Resources.Source_SignalAmplitude}"/>
                            <TextBox Text="{Binding AudioSource.Amplitude, UpdateSourceTrigger=PropertyChanged}"/>

                            <Label Content="{x:Static properties:Resources.Source_SignalPhase}"/>
                            <TextBox Text="{Binding AudioSource.Phase, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </TabItem>

            <!-- Вкладка геометрии решетки -->
            <TabItem Header="{x:Static properties:Resources.Array}">
                <StackPanel>
                    <GroupBox Header="{x:Static properties:Resources.Array_ArrayCenter}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>

                            <Label Content="{x:Static properties:Resources.Array_ArrayCenterX}" Grid.Row="0" Grid.Column="0"/>
                            <TextBox Text="{Binding MicrophoneArray.CenterX, UpdateSourceTrigger=PropertyChanged}" 
                                    Grid.Row="0" Grid.Column="1"/>

                            <Label Content="{x:Static properties:Resources.Array_ArrayCenterY}" Grid.Row="1" Grid.Column="0"/>
                            <TextBox Text="{Binding MicrophoneArray.CenterY, UpdateSourceTrigger=PropertyChanged}" 
                                    Grid.Row="1" Grid.Column="1"/>

                            <Label Content="{x:Static properties:Resources.Array_ArrayCenterZ}" Grid.Row="2" Grid.Column="0"/>
                            <TextBox Text="{Binding MicrophoneArray.CenterZ, UpdateSourceTrigger=PropertyChanged}" 
                                    Grid.Row="2" Grid.Column="1"/>
                        </Grid>
                    </GroupBox>

                    <GroupBox Header="{x:Static properties:Resources.Array_ArrayParametrs}">
                        <StackPanel>
                            <Label Content="{x:Static properties:Resources.Array_Radius}"/>
                            <TextBox Text="{Binding MicrophoneArray.Radius, UpdateSourceTrigger=PropertyChanged}"/>

                            <Label Content="{x:Static properties:Resources.Array_MicrophonesCount}"/>
                            <ComboBox SelectedValue="{Binding MicrophoneArray.MicrophoneCount}"
                                SelectedValuePath="Content"
                                Margin="0,0,0,10">
                                <ComboBoxItem>4</ComboBoxItem>
                                <ComboBoxItem>8</ComboBoxItem>
                                <ComboBoxItem>16</ComboBoxItem>
                                <ComboBoxItem>32</ComboBoxItem>
                            </ComboBox>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </TabItem>

            <!-- Вкладка сетевых настроек -->
            <TabItem Header="{x:Static properties:Resources.Network}">
                <StackPanel>
                    <GroupBox Header="{x:Static properties:Resources.Network_ServerSettings}">
                        <StackPanel>
                            <Label Content="{x:Static properties:Resources.Network_LocalIP}"/>
                            <ComboBox ItemsSource="{Binding NetworkSettings.AvailableIPs}"
                         SelectedItem="{Binding NetworkSettings.LocalIP}"
                         Margin="0,0,0,10"/>

                            <Label Content="{x:Static properties:Resources.Network_LocalPort}"/>
                            <TextBox Text="{Binding NetworkSettings.LocalPort, UpdateSourceTrigger=PropertyChanged}"
                        Margin="0,0,0,10"/>

                            <Label Content="{x:Static properties:Resources.Network_RemoteIP}"/>
                            <TextBox Text="{Binding NetworkSettings.RemoteIP, UpdateSourceTrigger=PropertyChanged}"
                        Margin="0,0,0,10"/>

                            <Label Content="{x:Static properties:Resources.Network_RemotePort}"/>
                            <TextBox Text="{Binding NetworkSettings.RemotePort, UpdateSourceTrigger=PropertyChanged}"
                        Margin="0,0,0,10"/>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10">
                                <Button Content="{x:Static properties:Resources.Network_StartServer}" 
                           Command="{Binding StartServerCommand}"
                           Margin="0,0,10,0" Padding="10,5"/>
                                <Button Content="{x:Static properties:Resources.Network_StopServer}" 
                           Command="{Binding StopServerCommand}"
                           Padding="10,5"/>
                            </StackPanel>

                            <TextBlock Text="{Binding NetworkStatus}" 
                          Margin="0,10" 
                          HorizontalAlignment="Center"
                          FontWeight="Bold"
                          Foreground="{Binding NetworkStatusColor}"/>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </TabItem>

        </TabControl>

        <Button Content="{x:Static properties:Resources.Button_Apply}" Command="{Binding ApplySettingsCommand}"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                Margin="0,375,0,0" Padding="20,5" FontWeight="Bold" Grid.Column="1" Click="ApplyButton_Click"/>
    </Grid>
</Window>