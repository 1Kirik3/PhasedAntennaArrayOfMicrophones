<Window x:Class="PAAOM_Server.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
        xmlns:local="clr-namespace:PAAOM_Server"
        mc:Ignorable="d"
        Title="MainWindow" Height="484" Width="582">
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="HeaderStyle">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,5"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Панель с управляющими кнопками -->
        <Grid Grid.Row="0" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Кнопка Обновить -->
            <Button x:Name="UpdateButton" 
                    Grid.Column="0"
                    Content="Обновить графики" 
                    Padding="15,5"
                    FontWeight="Bold"
                    HorizontalAlignment="Left"
                    Click="UpdateButton_Click" Height="30" VerticalAlignment="Top"/>

            <!-- Кнопка Настройки -->
            <Button Grid.Column="1"
                    Content="Настройки" 
                    Width="100"
                    Height="30"
                    HorizontalAlignment="Right"
                    Click="SettingsButton_Click"/>
        </Grid>

        <!-- Область с графиками -->
        <ScrollViewer Grid.Row="1">
            <ItemsControl x:Name="MicrophonesContainer">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="Gray" BorderThickness="1" Margin="5">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" 
                                           HorizontalAlignment="Center"
                                           FontWeight="Bold"/>
                                <lvc:CartesianChart Series="{Binding Series}" 
                                                   Height="200"
                                                   DisableAnimations="True">
                                    <lvc:CartesianChart.AxisY>
                                        <lvc:Axis MinValue="-1" MaxValue="1"/>
                                    </lvc:CartesianChart.AxisY>
                                </lvc:CartesianChart>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>