<Window x:Class="PAAOM_Server.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:properties="clr-namespace:PAAOM_Server.Properties"
        xmlns:validation="clr-namespace:PAAOM_Common.ValidationRules;assembly=PAAOM_Common"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="{x:Static properties:Resources.MainWindow_SystemParametrs}" 
        Height="600" 
        Width="800"
        MinWidth="700"
        MinHeight="500">

    <Window.Resources>
        <!-- Стиль для TextBox с валидацией -->
        <Style TargetType="TextBox" x:Key="ValidatedTextBox">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="true">
                    <Setter Property="ToolTip" 
                            Value="{Binding RelativeSource={RelativeSource Self}, 
                                   Path=(Validation.Errors)[0].ErrorContent}"/>
                    <Setter Property="Background" Value="#FFFFE0E0"/>
                    <Setter Property="BorderBrush" Value="Red"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Label">
            <Setter Property="Margin" Value="0,10,0,0"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Padding" Value="10"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="MinWidth" Value="100"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Заголовок и статус -->
            <RowDefinition Height="Auto"/>
            <!-- Панель кнопок -->
            <RowDefinition Height="*"/>
            <!-- TabControl (займет все оставшееся пространство) -->
        </Grid.RowDefinitions>

        <!-- Верхняя панель с заголовком и статусом -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10" HorizontalAlignment="Center">
            <TextBlock Text="{x:Static properties:Resources.MainWindow_Titile}" FontSize="16" FontWeight="Bold" Margin="0,0,10,0"/>
            <TextBlock Text="{Binding NetworkSettings.NetworkStatus}" 
               FontWeight="Bold"
               Foreground="{Binding NetworkSettings.NetworkStatusColor}"
               VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Панель управления настройками -->
        <Border Grid.Row="1" Background="#F0F0F0" Padding="10" Margin="10,5,10,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="{x:Static properties:Resources.MainWindow_LoadSettingsButton}"
                        Command="{Binding LoadSettingsCommand}"
                        ToolTip="Загрузить сохраненные настройки из файла"
                        Style="{StaticResource {x:Type Button}}"
                        MinWidth="120"/>

                <Button Content="{x:Static properties:Resources.MainWindow_SaveSettingsButton}"
                        Command="{Binding SaveSettingsCommand}"
                        ToolTip="Сохранить текущие настройки в файл"
                        Style="{StaticResource {x:Type Button}}"
                        MinWidth="120"/>

                <Button Content="{x:Static properties:Resources.MainWindow_ApplySettingsButton}"
                        Command="{Binding ApplySettingsCommand}"
                        ToolTip="Применить текущие настройки системы"
                        Style="{StaticResource {x:Type Button}}"
                        MinWidth="120"
                        FontWeight="Bold"
                        Margin="20,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- Основная область с настройками -->
        <TabControl Grid.Row="2" Margin="10,0,10,10">
            <!-- Вкладка параметров среды -->
            <TabItem Header="{x:Static properties:Resources.Environment}">
                <ScrollViewer>
                    <StackPanel>
                        <GroupBox Header="{x:Static properties:Resources.Environment_AirParametrs}">
                            <StackPanel>
                                <Label Content="{x:Static properties:Resources.Environment_AirTemperature}"/>
                                <TextBox Style="{StaticResource ValidatedTextBox}">
                                    <TextBox.Text>
                                        <Binding Path="EnvironmentSettings.Temperature" UpdateSourceTrigger="PropertyChanged">
                                            <Binding.ValidationRules>
                                                <validation:NumericValidationRule 
                                                    Min="{x:Static validation:ValidationConstants.MinTemperature}"
                                                    Max="{x:Static validation:ValidationConstants.MaxTemperature}"
                                                    ErrorMessage="Температура должна быть между -100 и 100°C"/>
                                            </Binding.ValidationRules>
                                        </Binding>
                                    </TextBox.Text>
                                </TextBox>

                                <Label Content="{x:Static properties:Resources.Environment_NoiseLevel}"/>
                                <TextBox Style="{StaticResource ValidatedTextBox}">
                                    <TextBox.Text>
                                        <Binding Path="EnvironmentSettings.NoiseLevel" UpdateSourceTrigger="PropertyChanged">
                                            <Binding.ValidationRules>
                                                <validation:NumericValidationRule 
                                                    Min="{x:Static validation:ValidationConstants.MinNoiseLevel}"
                                                    Max="{x:Static validation:ValidationConstants.MaxNoiseLevel}"
                                                    ErrorMessage="Уровень шума должен быть между 0 и 1"/>
                                            </Binding.ValidationRules>
                                        </Binding>
                                    </TextBox.Text>
                                </TextBox>

                                <Label Content="{x:Static properties:Resources.Environment_SoundSpeed}"/>
                                <TextBlock Text="{Binding EnvironmentSettings.SoundSpeed, StringFormat={}{0:F2}}"
                                    Margin="0,5" FontStyle="Italic"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Вкладка источника звука -->
            <TabItem Header="{x:Static properties:Resources.Source}">
                <ScrollViewer>
                    <StackPanel>
                        <GroupBox Header="{x:Static properties:Resources.Source_Pos}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>

                                <Label Content="{x:Static properties:Resources.Source_PosX}" Grid.Row="0" Grid.Column="0"/>
                                <TextBox Style="{StaticResource ValidatedTextBox}" Grid.Row="0" Grid.Column="1">
                                    <TextBox.Text>
                                        <Binding Path="AudioSource.X" UpdateSourceTrigger="PropertyChanged">
                                            <Binding.ValidationRules>
                                                <validation:NumericValidationRule 
                                                    Min="{x:Static validation:ValidationConstants.MinCoordinate}"
                                                    Max="{x:Static validation:ValidationConstants.MaxCoordinate}"
                                                    ErrorMessage="Координата X должна быть в пределах ±1000 м"/>
                                            </Binding.ValidationRules>
                                        </Binding>
                                    </TextBox.Text>
                                </TextBox>

                                <Label Content="{x:Static properties:Resources.Source_PosY}" Grid.Row="1" Grid.Column="0"/>
                                <TextBox Style="{StaticResource ValidatedTextBox}" Grid.Row="1" Grid.Column="1">
                                    <TextBox.Text>
                                        <Binding Path="AudioSource.Y" UpdateSourceTrigger="PropertyChanged">
                                            <Binding.ValidationRules>
                                                <validation:NumericValidationRule 
                                                    Min="{x:Static validation:ValidationConstants.MinCoordinate}"
                                                    Max="{x:Static validation:ValidationConstants.MaxCoordinate}"
                                                    ErrorMessage="Координата Y должна быть в пределах ±1000 м"/>
                                            </Binding.ValidationRules>
                                        </Binding>
                                    </TextBox.Text>
                                </TextBox>

                                <Label Content="{x:Static properties:Resources.Source_PosZ}" Grid.Row="2" Grid.Column="0"/>
                                <TextBox Style="{StaticResource ValidatedTextBox}" Grid.Row="2" Grid.Column="1">
                                    <TextBox.Text>
                                        <Binding Path="AudioSource.Z" UpdateSourceTrigger="PropertyChanged">
                                            <Binding.ValidationRules>
                                                <validation:NumericValidationRule 
                                                    Min="{x:Static validation:ValidationConstants.MinCoordinate}"
                                                    Max="{x:Static validation:ValidationConstants.MaxCoordinate}"
                                                    ErrorMessage="Координата Z должна быть в пределах ±1000 м"/>
                                            </Binding.ValidationRules>
                                        </Binding>
                                    </TextBox.Text>
                                </TextBox>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="{x:Static properties:Resources.Source_SignalParametrs}">
                            <StackPanel>
                                <Label Content="{x:Static properties:Resources.Source_SignalFrequency}"/>
                                <TextBox Style="{StaticResource ValidatedTextBox}">
                                    <TextBox.Text>
                                        <Binding Path="AudioSource.Frequency" UpdateSourceTrigger="PropertyChanged">
                                            <Binding.ValidationRules>
                                                <validation:NumericValidationRule 
                                                    Min="0"
                                                    Max="{x:Static validation:ValidationConstants.MaxFrequency}"
                                                    ErrorMessage="Частота не должна превышать 625 Гц (по теореме Найквиста)"/>
                                            </Binding.ValidationRules>
                                        </Binding>
                                    </TextBox.Text>
                                </TextBox>

                                <Label Content="{x:Static properties:Resources.Source_SignalAmplitude}"/>
                                <TextBox Style="{StaticResource ValidatedTextBox}">
                                    <TextBox.Text>
                                        <Binding Path="AudioSource.Amplitude" UpdateSourceTrigger="PropertyChanged">
                                            <Binding.ValidationRules>
                                                <validation:NumericValidationRule 
                                                    Min="{x:Static validation:ValidationConstants.MinAmplitude}"
                                                    Max="{x:Static validation:ValidationConstants.MaxAmplitude}"
                                                    ErrorMessage="Амплитуда должна быть между 0 и 10"/>
                                            </Binding.ValidationRules>
                                        </Binding>
                                    </TextBox.Text>
                                </TextBox>

                                <Label Content="{x:Static properties:Resources.Source_SignalPhase}"/>
                                <TextBox Style="{StaticResource ValidatedTextBox}">
                                    <TextBox.Text>
                                        <Binding Path="AudioSource.Phase" UpdateSourceTrigger="PropertyChanged">
                                            <Binding.ValidationRules>
                                                <validation:NumericValidationRule 
                                                    Min="{x:Static validation:ValidationConstants.MinPhase}"
                                                    Max="{x:Static validation:ValidationConstants.MaxPhase}"
                                                    ErrorMessage="Фаза должна быть между -π и π радиан"/>
                                            </Binding.ValidationRules>
                                        </Binding>
                                    </TextBox.Text>
                                </TextBox>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Вкладка геометрии решетки -->
            <TabItem Header="{x:Static properties:Resources.Array}">
                <ScrollViewer>
                    <StackPanel>
                        <GroupBox Header="{x:Static properties:Resources.Array_ArrayCenter}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>

                                <Label Content="{x:Static properties:Resources.Array_ArrayCenterX}" Grid.Row="0" Grid.Column="0"/>
                                <TextBox Style="{StaticResource ValidatedTextBox}" Grid.Row="0" Grid.Column="1">
                                    <TextBox.Text>
                                        <Binding Path="MicrophoneArray.CenterX" UpdateSourceTrigger="PropertyChanged">
                                            <Binding.ValidationRules>
                                                <validation:NumericValidationRule 
                                                    Min="{x:Static validation:ValidationConstants.MinCoordinate}"
                                                    Max="{x:Static validation:ValidationConstants.MaxCoordinate}"
                                                    ErrorMessage="Координата X центра должна быть в пределах ±1000 м"/>
                                            </Binding.ValidationRules>
                                        </Binding>
                                    </TextBox.Text>
                                </TextBox>

                                <Label Content="{x:Static properties:Resources.Array_ArrayCenterY}" Grid.Row="1" Grid.Column="0"/>
                                <TextBox Style="{StaticResource ValidatedTextBox}" Grid.Row="1" Grid.Column="1">
                                    <TextBox.Text>
                                        <Binding Path="MicrophoneArray.CenterY" UpdateSourceTrigger="PropertyChanged">
                                            <Binding.ValidationRules>
                                                <validation:NumericValidationRule 
                                                    Min="{x:Static validation:ValidationConstants.MinCoordinate}"
                                                    Max="{x:Static validation:ValidationConstants.MaxCoordinate}"
                                                    ErrorMessage="Координата Y центра должна быть в пределах ±1000 м"/>
                                            </Binding.ValidationRules>
                                        </Binding>
                                    </TextBox.Text>
                                </TextBox>

                                <Label Content="{x:Static properties:Resources.Array_ArrayCenterZ}" Grid.Row="2" Grid.Column="0"/>
                                <TextBox Style="{StaticResource ValidatedTextBox}" Grid.Row="2" Grid.Column="1">
                                    <TextBox.Text>
                                        <Binding Path="MicrophoneArray.CenterZ" UpdateSourceTrigger="PropertyChanged">
                                            <Binding.ValidationRules>
                                                <validation:NumericValidationRule 
                                                    Min="{x:Static validation:ValidationConstants.MinCoordinate}"
                                                    Max="{x:Static validation:ValidationConstants.MaxCoordinate}"
                                                    ErrorMessage="Координата Z центра должна быть в пределах ±1000 м"/>
                                            </Binding.ValidationRules>
                                        </Binding>
                                    </TextBox.Text>
                                </TextBox>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="{x:Static properties:Resources.Array_ArrayParametrs}">
                            <StackPanel>
                                <Label Content="{x:Static properties:Resources.Array_Radius}"/>
                                <TextBox Style="{StaticResource ValidatedTextBox}">
                                    <TextBox.Text>
                                        <Binding Path="MicrophoneArray.Radius" UpdateSourceTrigger="PropertyChanged">
                                            <Binding.ValidationRules>
                                                <validation:NumericValidationRule 
                                                    Min="{x:Static validation:ValidationConstants.MinRadius}"
                                                    Max="{x:Static validation:ValidationConstants.MaxRadius}"
                                                    ErrorMessage="Радиус массива должен быть между 0.1 и 10 м"/>
                                            </Binding.ValidationRules>
                                        </Binding>
                                    </TextBox.Text>
                                </TextBox>

                                <Label Content="{x:Static properties:Resources.Array_MicrophonesCount}"/>
                                <ComboBox SelectedValue="{Binding MicrophoneArray.MicrophoneCount}"
                                    SelectedValuePath="Content"
                                    Margin="0,0,0,10">
                                    <ComboBoxItem>4</ComboBoxItem>
                                    <ComboBoxItem>8</ComboBoxItem>
                                    <ComboBoxItem>16</ComboBoxItem>
                                    <ComboBoxItem>32</ComboBoxItem>
                                </ComboBox>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Вкладка сетевых настроек и управления -->
            <TabItem Header="{x:Static properties:Resources.Network}">
                <ScrollViewer>
                    <StackPanel>
                        <GroupBox Header="{x:Static properties:Resources.Network_ServerSettings}">
                            <StackPanel>
                                <Label Content="{x:Static properties:Resources.Network_LocalIP}"/>
                                <ComboBox ItemsSource="{Binding NetworkSettings.AvailableIPs}"
                     SelectedItem="{Binding NetworkSettings.LocalIP}"
                     Margin="0,0,0,10"/>

                                <Label Content="{x:Static properties:Resources.Network_LocalPort}"/>
                                <TextBox Text="{Binding NetworkSettings.LocalPort, UpdateSourceTrigger=PropertyChanged}"
                    Margin="0,0,0,10"/>

                                <Label Content="{x:Static properties:Resources.Network_RemoteIP}"/>
                                <TextBox Text="{Binding NetworkSettings.RemoteIP, UpdateSourceTrigger=PropertyChanged}"
                    Margin="0,0,0,10"/>

                                <Label Content="{x:Static properties:Resources.Network_RemotePort}"/>
                                <TextBox Text="{Binding NetworkSettings.RemotePort, UpdateSourceTrigger=PropertyChanged}"
                    Margin="0,0,0,10"/>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20">
                                    <Button Content="{x:Static properties:Resources.Network_StartServer}" 
                        Command="{Binding NetworkSettings.StartServerCommand}"
                        Margin="5" Padding="15,5" MinWidth="100"/>

                                    <Button Content="{x:Static properties:Resources.Network_StopServer}" 
                        Command="{Binding NetworkSettings.StopServerCommand}"
                        Margin="5" Padding="15,5" MinWidth="100"/>

                                    <Button Content="{x:Static properties:Resources.Network_TestConnection}" 
                        Command="{Binding NetworkSettings.TestConnectionCommand}"
                        Margin="5" Padding="15,5" MinWidth="100"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10">
                                    <Button Content="{x:Static properties:Resources.Network_SendReport}"
                        Command="{Binding SendDetectionReportCommand}"
                        Margin="5" Padding="15,5" MinWidth="120"/>

                                    <Button Content="{x:Static properties:Resources.Network_SendPacket}"
                        Command="{Binding SendAdcDataCommand}"
                        Margin="5" Padding="15,5" MinWidth="120"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <!-- Упрощенная группа для управления отправкой данных -->
                        <GroupBox Header="{x:Static properties:Resources.Network_DataSenderController}" Margin="0,10,0,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="{Binding NetworkSettings.IsSendingDataText}"
                        Command="{Binding NetworkSettings.ToggleDataSendingCommand}"
                        Margin="5" Padding="15,5" MinWidth="120"/>
                                </StackPanel>
                                <TextBlock Text="{Binding CurrentDistance, StringFormat='Расстояние: {0:F2} м'}"
                        HorizontalAlignment="Center" Margin="0,5"
                        FontStyle="Italic"/>
                                <TextBlock Text="{Binding SoundTransmissionTimeMs, StringFormat='Время передачи: {0:F2} мс'}"
                        HorizontalAlignment="Center" Margin="0,5"
                        FontStyle="Italic"/>
                                <TextBlock Text="{Binding NetworkSettings.PacketCounter, StringFormat='Отправлено пакетов: {0}'}"
                        HorizontalAlignment="Center" Margin="0,5"
                        FontStyle="Italic"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>