<Window x:Class="PAAOM_Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
        xmlns:local="clr-namespace:PAAOM_Client"
        mc:Ignorable="d"
        Title="PAAOM Client - Графики сигналов" Height="750" Width="1000">
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="HeaderStyle">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,5"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="DetectionInfoStyle">
            <Setter Property="Margin" Value="5,3"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="MinWidth" Value="110"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Первая строка: Панель управления и статус -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10,5" HorizontalAlignment="Left">
            <Button x:Name="ConnectButton" Content="Подключиться" 
                    Click="ConnectButton_Click" Margin="5" Padding="10,5"/>
            <Button x:Name="DisconnectButton" Content="Отключиться" 
                    Click="DisconnectButton_Click" Margin="5" Padding="10,5"/>
            <TextBlock x:Name="StatusText" Margin="10" VerticalAlignment="Center" 
                       TextWrapping="Wrap" MinWidth="200"/>
        </StackPanel>

        <!-- Вторая строка: Панель информации об обнаружении -->
        <Border Grid.Row="1" Background="LightBlue" Margin="5" Padding="8">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel x:Name="DetectionPanel" Orientation="Horizontal" 
                            HorizontalAlignment="Center" DataContext="{Binding}">

                    <!-- Колонка 1: Время и номер -->
                    <StackPanel Orientation="Vertical" Margin="0,0,5,0">
                        <TextBlock Text="{Binding DetectionTime}" Style="{StaticResource DetectionInfoStyle}" 
                                   FontWeight="Bold" Background="LightYellow" Padding="3"/>
                        <TextBlock Text="{Binding MeasurementNumber}" Style="{StaticResource DetectionInfoStyle}"/>
                        <TextBlock Text="{Binding TargetType}" Style="{StaticResource DetectionInfoStyle}"/>
                    </StackPanel>

                    <!-- Колонка 2: ОСП и пеленг -->
                    <StackPanel Orientation="Vertical" Margin="5,0">
                        <TextBlock Text="{Binding SnrInfo}" Style="{StaticResource DetectionInfoStyle}"/>
                        <TextBlock Text="{Binding BearingInfo}" Style="{StaticResource DetectionInfoStyle}"/>
                        <TextBlock Text="{Binding BearingRateInfo}" Style="{StaticResource DetectionInfoStyle}"/>
                    </StackPanel>

                    <!-- Колонка 3: Дистанция -->
                    <StackPanel Orientation="Vertical" Margin="5,0">
                        <TextBlock Text="{Binding DistanceInfo}" Style="{StaticResource DetectionInfoStyle}"/>
                        <TextBlock Text="{Binding DistanceRateInfo}" Style="{StaticResource DetectionInfoStyle}"/>
                    </StackPanel>

                    <!-- Колонка 4: СКО -->
                    <StackPanel Orientation="Vertical" Margin="5,0">
                        <TextBlock Text="{Binding AngleStdDevInfo}" Style="{StaticResource DetectionInfoStyle}"/>
                        <TextBlock Text="{Binding TimeStdDevInfo}" Style="{StaticResource DetectionInfoStyle}"/>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Третья строка: Область с графиками -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="MicrophonesContainer" Margin="5">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="Gray" BorderThickness="1" Margin="5" Padding="5">
                            <StackPanel>
                                <!-- Заголовок и кнопка спектра -->
                                <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{Binding Title}" 
                                               Grid.Column="0"
                                               Style="{StaticResource HeaderStyle}"
                                               TextWrapping="Wrap"/>

                                    <Button Content="Спектр" 
                                            Grid.Column="1"
                                            Command="{Binding ShowSpectrumCommand}"
                                            Margin="5,0"
                                            Padding="10,2"
                                            MinWidth="60"/>
                                </Grid>

                                <!-- График сигнала -->
                                <lvc:CartesianChart Series="{Binding Series}" 
                                    Height="200"
                                    DisableAnimations="True"
                                    Margin="0,5">
                                    <lvc:CartesianChart.AxisX>
                                        <lvc:Axis Title="Время, мс" 
                                            LabelFormatter="{Binding XAxisFormatter}">
                                            <lvc:Axis.Separator>
                                                <lvc:Separator Step="{Binding TimeStep}"/>
                                            </lvc:Axis.Separator>
                                        </lvc:Axis>
                                    </lvc:CartesianChart.AxisX>
                                    <lvc:CartesianChart.AxisY>
                                        <lvc:Axis Title="Амплитуда" 
                                            LabelFormatter="{Binding YAxisFormatter}"/>
                                    </lvc:CartesianChart.AxisY>
                                </lvc:CartesianChart>

                                <!-- Информация о пакете -->
                                <TextBlock Text="{Binding PacketInfo}" 
                                           Margin="5" FontStyle="Italic" 
                                           HorizontalAlignment="Center"
                                           TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>