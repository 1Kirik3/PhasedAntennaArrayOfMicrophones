<Window x:Class="PAAOM_Client.SpectrumWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
        xmlns:properties="clr-namespace:PAAOM_Client.Properties"
        mc:Ignorable="d"
        Title="{x:Static properties:Resources.SpectrumWindow_Title}"
        Height="500" 
        Width="700"
        MinWidth="400"
        MinHeight="300"
        WindowStartupLocation="CenterOwner"
        Background="#FFF0F0F0">

    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок и кнопки управления -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5">
            <Button x:Name="BtnAutoScale" 
                    Content="{x:Static properties:Resources.SpectrumWindow_Autoscale}"
                    Width="100" 
                    Margin="5,0"
                    Click="AutoScale_Click"
                    ToolTip="{x:Static properties:Resources.SpectrumWindow_Autoscale_Tooltip}"/>
        </StackPanel>

        <!-- Основной график -->
        <lvc:CartesianChart x:Name="SpectrumChart"
                          Grid.Row="1"
                          LegendLocation="None"
                          Hoverable="True"
                          DisableAnimations="True"
                          Zoom="Xy"
                          DataTooltip="{x:Null}"
                          Padding="5"
                          Margin="0"
                          Background="White"
                          ClipToBounds="True">

            <lvc:CartesianChart.AxisX>
                <lvc:Axis Title="{x:Static properties:Resources.SpectrumWindow_FrequencyAxis}" 
                       LabelFormatter="{Binding XAxisFormatter}"/>
            </lvc:CartesianChart.AxisX>

            <lvc:CartesianChart.AxisY>
                <lvc:Axis Title="{x:Static properties:Resources.SpectrumWindow_AmplitudeAxis}"
                       LabelFormatter="{Binding YAxisFormatter}"/>
            </lvc:CartesianChart.AxisY>
        </lvc:CartesianChart>

        <!-- Статусная строка -->
        <StatusBar Grid.Row="2" Background="#FFE0E0E0">
            <StatusBarItem>
                <TextBlock x:Name="PeakInfo" Text="Пик: не определен"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="FrequencyRange" Text="Диапазон: 0 - 0 Гц"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>